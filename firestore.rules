rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false; // Create/change admins manually in Firebase console.
    }
    match /catalog/{itemId} {
      allow read: if signedIn();
      allow create, update: if admin() && request.resource.data.id == itemId
        && request.resource.data.price is number && request.resource.data.price >= 0
        && request.resource.data.category in ['paid','free']
        && (request.resource.data.category != 'free' || request.resource.data.price == 0);
      allow delete: if false;
    }
    match /orders/{orderId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'Draft';
      allow update: if signedIn()
        && request.resource.data.createdBy == resource.data.createdBy
        && (admin() || resource.data.createdBy == request.auth.uid);
      allow delete: if false;
    }
  }
}
